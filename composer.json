{
  "name": "igorosabel/api-game",
  "description": "API para la aplicación Game",
  "type": "project",
  "keywords": ["igorosabel", "game", "angular", "osumi"],
  "homepage": "https://github.com/igorosabel/ApiGame",
  "license": "MIT",
  "authors": [
    {
      "name": "Iñigo Gorosabel",
      "homepage": "https://osumi.es",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "osumionline/framework": "^9.12.1",
    "osumionline/plugin-email": "^3.0",
    "osumionline/plugin-token": "^3.0",
    "osumionline/plugin-websocket": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Osumi\\OsumiFramework\\App\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "osumionline/plugin-updater": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
